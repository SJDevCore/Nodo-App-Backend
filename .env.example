# Puerto del servidor HTTP
PORT=3000

# Entorno: development | production | test
NODE_ENV=development

# Cadena de conexión de MongoDB Atlas (incluye el nombre de la base después de .net/)
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<base-de-datos>?retryWrites=true&w=majority
# Clave para firmar los JWT: mínimo 32 caracteres (usa un valor aleatorio largo en cada entorno)
JWT_SECRET=cambia-esta-clave-por-una-aleatoria-de-32+caracteres
# Duración del token: formato como 15m, 12h o 7d
JWT_EXPIRES_IN=7d